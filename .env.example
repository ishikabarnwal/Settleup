# Copy to .env.local and adjust. Vite only exposes variables prefixed with VITE_.

# Base URL of the SettleUp backend.
# Leave empty during development: the app then calls /api on its own origin and
# the Vite dev server proxies it to VITE_DEV_PROXY_TARGET.
# Set it for a build that talks to a deployed backend, e.g.
#   VITE_API_URL=https://settleup-api.example.com
# (that backend must list this site in its CORS_ALLOWED_ORIGINS).
VITE_API_URL=

# Backend the dev server proxies /api to when VITE_API_URL is empty.
VITE_DEV_PROXY_TARGET=http://127.0.0.1:8080
